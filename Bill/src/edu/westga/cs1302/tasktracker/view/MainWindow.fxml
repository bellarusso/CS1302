<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" 
          fx:controller="edu.westga.cs1302.tasktracker.view.MainWindow"
          hgap="10" vgap="10">
    
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Input fields for adding a new task -->
    <Label text="Task Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
    <TextArea fx:id="descriptionField" prefRowCount="3" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Priority:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <ComboBox fx:id="priorityBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Button text="Add Task" onAction="#addTask" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Button text="Remove Task" onAction="#removeTask" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
    <!-- List of tasks -->
    <Label text="Tasks:" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
    <ListView fx:id="taskList" prefHeight="150" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <!-- Selected task details -->
    <Label text="Selected Description:" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
    <TextArea fx:id="selectedDescriptionField" prefRowCount="3" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    <Button text="Update Description" onAction="#updateDescription" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
    <Label text="Selected Priority:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <TextField fx:id="selectedPriorityField" editable="false" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <!-- Count button -->
    <Button text="Count Tasks" onAction="#countTasks" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <!-- Task count display -->
    <Label text="Low Priority:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <TextField fx:id="lowCountField" editable="false" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

    <Label text="Medium Priority:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <TextField fx:id="mediumCountField" editable="false" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

    <Label text="High Priority:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
    <TextField fx:id="highCountField" editable="false" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

</GridPane>
