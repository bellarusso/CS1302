<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.tasktracker.view.MainWindow" prefWidth="600" prefHeight="400">
    
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <!-- Add Task Section -->
            <Label text="Add New Task"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="75"/>
                </columnConstraints>

                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="descriptionField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefRowCount="3"/>

                <Label text="Priority:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="priorityBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Button text="Add Task" onAction="#addTask" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Task List -->
            <Label text="Tasks"/>
            <ListView fx:id="taskList" prefHeight="150"/>

            <!-- Selected Task Display -->
            <Label text="Selected Task Details"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="75"/>
                </columnConstraints>

                <Label text="Description:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextArea fx:id="selectedDescriptionField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefRowCount="3"/>

                <Label text="Priority:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="selectedPriorityField" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="false"/>

                <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <Button text="Update Description" onAction="#updateDescription"/>
                    <Button text="Remove Task" onAction="#removeTask"/>
                </HBox>
            </GridPane>
        </VBox>
    </children>
</AnchorPane>
